# Editor / Backup / Log files
# ==========================================
*.swp
*.swo
*~
*.bak
*.tmp
*.log

# ==========================================
# VS Code local states (keep project configurations)
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/c_cpp_properties.json
!.vscode/launch.json
!.vscode/tasks.json
